{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node16",

    "lib": [
      "ES2020"
    ],

    "outDir": "./dist",
    "rootDir": "./src",

    "strict": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "allowJs": true,

    "noEmitOnError": false,

    "sourceMap": true
  },

  "include": [
    "src/**/*"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "api",
    "uploads",
    "prisma"
  ]
}