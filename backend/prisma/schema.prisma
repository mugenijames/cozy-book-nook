generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Book {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  author      String
  description String?
  genre       String?
  coverImage  String?

  publishedYear Int?
  pages         Int?
  rating        Float?
  priceCents    Int?

  // =========================================================
  // BOOK AVAILABILITY
  // =========================================================

  // Whether a physical/hardcopy version can be ordered
  hasHardcopy Boolean @default(false)

  // Digital book
  pdfUrl          String?
  pdfPreviewImage String?

  // AI-generated book information
  aiSummary   String?
  shortSummary String?
  pdfSummary  String?

  keyThemes      Json?
  keywords       Json?

  readingTime    String?
  targetAudience String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders          Order[]
  pendingPayments PendingPayment[]

  @@map("books")
}


model Order {
  id              String   @id @default(uuid())

  // =========================================================
  // BOOK
  // =========================================================

  bookId          String
  bookTitle       String

  // =========================================================
  // ORDER TYPE
  // =========================================================

  // DIGITAL = PDF purchase
  // HARDCOPY = physical book order
  orderType       String   @default("DIGITAL")

  // =========================================================
  // CUSTOMER
  // =========================================================

  customerName    String?
  email           String
  phoneNumber     String?

  // =========================================================
  // HARDCOPY DELIVERY INFORMATION
  // =========================================================

  deliveryLocation String?
  notes            String?

  // =========================================================
  // QUANTITY
  // =========================================================

  quantity        Int      @default(1)

  // =========================================================
  // PAYMENT
  // =========================================================

  paymentMethod   String
  transactionCode String   @unique
  amountCents     Int

  // =========================================================
  // ORDER STATUS
  // =========================================================

  // pending
  // confirmed
  // processing
  // shipped
  // delivered
  // cancelled
  status          String   @default("pending")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  book            Book     @relation(fields: [bookId], references: [id])

  @@index([email])
  @@index([status])
  @@index([orderType])
  @@index([transactionCode])
  @@index([createdAt])

  @@map("orders")
}


model PendingPayment {
  id                 String   @id @default(uuid())

  checkoutRequestID  String?  @unique
  paypalOrderId      String?  @unique

  bookId             String
  bookTitle          String

  email              String
  phoneNumber        String?

  amount             Float

  status             String   @default("pending")

  mpesaReceiptNumber String?
  paypalCaptureId    String?

  errorMessage       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  book               Book     @relation(fields: [bookId], references: [id])

  @@index([email])
  @@index([status])
  @@index([checkoutRequestID])
  @@index([paypalOrderId])

  @@map("pending_payments")
}


model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String?
  company   String?
  message   String   @db.Text
  rating    Int      @default(5)
  photoUrl  String?

  approved  Boolean  @default(false)
  featured  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([featured])
  @@index([createdAt])

  @@map("testimonials")
}