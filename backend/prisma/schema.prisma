generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Book Model
model Book {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  author        String
  description   String?
  genre         String?
  coverImage    String?
  publishedYear Int?
  pages         Int?
  rating        Float    @default(0.0)
  priceCents    Int?                    // Added for pricing
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders        Order[]

  @@index([title])
  @@index([author])
  @@map("books")
}

// Order Model (New)
model Order {
  id              String   @id @default(uuid())
  bookId          String
  bookTitle       String
  paymentMethod   String
  transactionCode String   @unique
  email           String
  amountCents     Int
  status          String   @default("approved")   // Changed to auto-approved

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  book            Book?    @relation(fields: [bookId], references: [id])

  @@index([email])
  @@index([status])
  @@map("orders")
}